<retail> a owl:Ontology;
  rdfs:comment "Initial retail vocabulary and mappings for the synthetic data-agent project."@en;
  rdfs:label "Retail data ontology"@en;
  owl:versionInfo "1.0" .

:joinCondition a owl:AnnotationProperty;
  rdfs:label "source join condition"@en .

:sourceColumn a owl:AnnotationProperty;
  rdfs:label "source column"@en .

:sourceGrain a owl:AnnotationProperty;
  rdfs:label "source grain"@en .

:sourcePrimaryKey a owl:AnnotationProperty;
  rdfs:label "source primary key"@en .

:sourceTable a owl:AnnotationProperty;
  rdfs:label "source table"@en .

xsd:date a rdfs:Datatype .

:containsLine a owl:ObjectProperty;
  rdfs:domain :Order;
  rdfs:range :OrderLine;
  rdfs:label "contains order line"@en, "包含订单明细"@zh;
  :joinCondition "fact_order.order_id = fact_order_line.order_id" .

:hasOrder a owl:ObjectProperty;
  rdfs:domain :Store;
  rdfs:range :Order;
  rdfs:label "has order"@en, "拥有订单"@zh;
  :joinCondition "dim_store.store_key = fact_order.store_key" .

:metricRequiresRelationship a owl:ObjectProperty;
  rdfs:domain :Metric;
  rdfs:range owl:ObjectProperty;
  rdfs:label "metric requires relationship"@en, "指标需要业务关系"@zh .

owl:ObjectProperty a owl:Class .

:metricSupportedDimension a owl:ObjectProperty;
  rdfs:domain :Metric;
  rdfs:range owl:Class;
  rdfs:label "metric supports dimension"@en, "指标支持维度"@zh .

owl:Class a owl:Class .

:metricUsesField a owl:ObjectProperty;
  rdfs:domain :Metric;
  rdfs:range :SourceField;
  rdfs:label "metric uses source field"@en, "指标使用来源字段"@zh .

:orderedOn a owl:ObjectProperty;
  rdfs:domain :Order;
  rdfs:range :CalendarDate;
  rdfs:label "ordered on date"@en, "下单日期"@zh;
  :joinCondition "fact_order.order_date_key = dim_date.date_key" .

:refersToProduct a owl:ObjectProperty;
  rdfs:domain :OrderLine;
  rdfs:range :Product;
  rdfs:label "refers to product"@en, "对应商品"@zh;
  :joinCondition "fact_order_line.product_key = dim_product.product_key" .

:fieldName a owl:DatatypeProperty;
  rdfs:domain :SourceField;
  rdfs:range xsd:string;
  rdfs:label "field name"@en, "字段名"@zh .

:fieldTable a owl:DatatypeProperty;
  rdfs:domain :SourceField;
  rdfs:range xsd:string;
  rdfs:label "field table"@en, "字段所在表"@zh .

:fullDate a owl:DatatypeProperty;
  rdfs:domain :CalendarDate;
  rdfs:range xsd:date;
  rdfs:label "full date"@en, "完整日期"@zh;
  :sourceColumn "dim_date.full_date" .

:lineQuantity a owl:DatatypeProperty;
  rdfs:domain :OrderLine;
  rdfs:range xsd:integer;
  rdfs:label "line quantity"@en, "明细数量"@zh;
  :sourceColumn "fact_order_line.quantity" .

:metricDefinition a owl:DatatypeProperty;
  rdfs:domain :Metric;
  rdfs:range xsd:string;
  rdfs:label "metric definition"@en, "指标定义"@zh .

:metricExpression a owl:DatatypeProperty;
  rdfs:domain :Metric;
  rdfs:range xsd:string;
  rdfs:label "metric expression"@en, "指标表达式"@zh .

:metricFilter a owl:DatatypeProperty;
  rdfs:domain :Metric;
  rdfs:range xsd:string;
  rdfs:label "metric filter"@en, "指标过滤条件"@zh .

:metricGrain a owl:DatatypeProperty;
  rdfs:domain :Metric;
  rdfs:range xsd:string;
  rdfs:label "metric grain"@en, "指标粒度"@zh .

:orderGmvAmount a owl:DatatypeProperty;
  rdfs:domain :Order;
  rdfs:range xsd:decimal;
  rdfs:label "order GMV amount"@en, "订单 GMV 金额"@zh;
  :sourceColumn "fact_order.gmv_amount" .

:orderIdentifier a owl:DatatypeProperty;
  rdfs:domain :Order;
  rdfs:range xsd:string;
  rdfs:label "order identifier"@en, "订单号"@zh;
  :sourceColumn "fact_order.order_id" .

:orderStatus a owl:DatatypeProperty;
  rdfs:domain :Order;
  rdfs:range xsd:string;
  rdfs:label "order status"@en, "订单状态"@zh;
  :sourceColumn "fact_order.status" .

:productName a owl:DatatypeProperty;
  rdfs:domain :Product;
  rdfs:range xsd:string;
  rdfs:label "product name"@en, "商品名称"@zh;
  :sourceColumn "dim_product.product_name" .

:storeCode a owl:DatatypeProperty;
  rdfs:domain :Store;
  rdfs:range xsd:string;
  rdfs:label "store code"@en, "门店编码"@zh;
  :sourceColumn "dim_store.store_code" .

:CalendarDate a owl:Class;
  rdfs:comment "A calendar date used to group retail transactions."@en;
  rdfs:label "Calendar date"@en, "日期"@zh;
  :sourceGrain "one row per calendar date"@en;
  :sourcePrimaryKey "date_key";
  :sourceTable "dim_date" .

:Metric a owl:Class;
  rdfs:comment "A governed measure with an explicit calculation meaning and data grain."@en;
  rdfs:label "Business metric"@en, "业务指标"@zh .

:Order a owl:Class;
  rdfs:comment "A customer purchase recorded by a retail store."@en;
  rdfs:label "Order"@en, "订单"@zh;
  :sourceGrain "one row per order"@en;
  :sourcePrimaryKey "order_id";
  :sourceTable "fact_order" .

:OrderLine a owl:Class;
  rdfs:comment "One product line within an order."@en;
  rdfs:label "Order line"@en, "订单明细"@zh;
  :sourceGrain "one row per product line in an order"@en;
  :sourcePrimaryKey "order_line_id";
  :sourceTable "fact_order_line" .

:Product a owl:Class;
  rdfs:comment "A retail product that can appear on an order line."@en;
  rdfs:label "Product"@en, "商品"@zh;
  :sourceGrain "one row per product"@en;
  :sourcePrimaryKey "product_key";
  :sourceTable "dim_product" .

:SourceField a owl:Class;
  rdfs:comment "A physical field used by a business metric or semantic mapping."@en;
  rdfs:label "Source field"@en, "来源字段"@zh .

:Store a owl:Class;
  rdfs:comment "A retail location that accepts customer orders."@en;
  rdfs:label "Store"@en, "门店"@zh;
  :sourceGrain "one row per store"@en;
  :sourcePrimaryKey "store_key";
  :sourceTable "dim_store" .
